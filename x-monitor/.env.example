# ============================================================
#  X Monitor — configuration. Copy to .env and fill in values.
#  Never commit .env: it contains secrets.
# ============================================================

# --- Telegram -------------------------------------------------
# Bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot, e.g. 123456789,987654321
# (send /start to the bot: it replies with your ID if you are not on the list yet)
TELEGRAM_ALLOWED_USER_IDS=

# --- X API ----------------------------------------------------
# App-only Bearer Token from https://console.x.com (Apps -> your app -> Keys and tokens)
X_BEARER_TOKEN=
# auto | legacy (tweet.fields) | v2 (post.fields). Keep "auto".
X_API_PARAM_DIALECT=auto
# Include original/quoted/replied-to posts in notifications (may cost extra post reads)
X_FETCH_REFERENCES=true
# Max pages of 100 posts fetched per account per check
X_MAX_PAGES_PER_POLL=3

# --- PostgreSQL (used by docker-compose) ----------------------
POSTGRES_USER=xmonitor
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=xmonitor

# For running without Docker set these explicitly
# (docker-compose overrides them with the internal service addresses):
# DATABASE_URL=postgresql+asyncpg://xmonitor:password@localhost:5432/xmonitor
# REDIS_URL=redis://localhost:6379/0

# --- Monitoring -----------------------------------------------
# Default check interval for new users, seconds (changeable in the bot)
DEFAULT_POLL_INTERVAL_SECONDS=60
# Lowest interval selectable in the bot, seconds
MIN_POLL_INTERVAL_SECONDS=15
# Parallel X API requests
MONITOR_CONCURRENCY=5
# Consecutive failures before an error alert is sent to Telegram
ERROR_NOTIFY_THRESHOLD=3
# Default timezone for new users (IANA name)
DEFAULT_TIMEZONE=Europe/Moscow

# --- Auto-buy of Pons tokens (Robinhood Chain) ----------------
# Off by default. When enabled, a monitored account's OWN post containing a token contract
# address (e.g. "$CA:0x…") triggers a buy on Pons. Limits are configured in the bot (💰 menu).
TRADING_ENABLED=false
# Private key of a SEPARATE wallet used only by the bot. Keep only what you are ready to lose.
# Never reuse your main wallet and never share this value.
WALLET_PRIVATE_KEY=
# Robinhood Chain RPC (chain id 4663). The public endpoint works; a paid one (Alchemy etc.) is faster.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Telegram IDs allowed to trade (empty = all users from TELEGRAM_ALLOWED_USER_IDS)
TRADING_ALLOWED_USER_IDS=
# Skip buys for posts older than this (e.g. after the server was down), seconds
TRADE_MAX_AGE_SECONDS=300
# ETH always kept in the wallet for gas
TRADE_GAS_RESERVE_ETH=0.0005

# --- Service --------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
API_PORT=8080

# --- Backups (docker-compose "backup" service) ----------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
